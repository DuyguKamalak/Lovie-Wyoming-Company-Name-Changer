# Free key from https://aistudio.google.com/apikey — required.
GEMINI_API_KEY=

# Optional second free Google AI Studio key (same model). If a chat request
# hits a 429 on GEMINI_API_KEY, the app automatically retries with this one
# — a same-day quota fallback, not a different provider/model. Safe to
# leave unset; behavior without it is unchanged.
GEMINI_API_KEY_FALLBACK=

# Optional. Defaults to gemini-flash-lite-latest (500 requests/day on the
# free tier) if unset — see .specify/specs/001-wyoming-name-change/plan.md
# section 9 for why the flagship gemini-flash-latest isn't the default
# (20 requests/day).
GEMINI_MODEL=
