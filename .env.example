# Free key from https://aistudio.google.com/apikey — required.
GEMINI_API_KEY=

# Optional extra free Google AI Studio keys. If a request hits a rate
# limit (429), a restricted project (403), or a rejected key (401), the app
# automatically tries the next key before giving up.
#
# Free-tier capacity is per key and the binding limit is requests-per-
# MINUTE (15 RPM on flash-lite), not per day — so extra keys are the only
# real way to raise the ceiling. Each additional key adds another 15 RPM.
# Use different Google accounts; a second key on a restricted project is
# worse than none.
#
# GEMINI_API_KEYS takes a comma-separated list, so you can add as many as
# you like. GEMINI_API_KEY_FALLBACK is the older single-spare variable and
# still works.
GEMINI_API_KEY_FALLBACK=
GEMINI_API_KEYS=

# Optional. Defaults to gemini-flash-lite-latest (500 requests/day on the
# free tier) if unset — see .specify/specs/001-wyoming-name-change/plan.md
# section 9 for why the flagship gemini-flash-latest isn't the default
# (20 requests/day).
GEMINI_MODEL=
